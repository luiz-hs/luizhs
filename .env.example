# Copie para .env.local e preencha o que tiver. Tudo é opcional —
# a plataforma funciona sem credenciais, com recursos reduzidos.

# Mercado Livre: crie uma aplicação gratuita em
# https://developers.mercadolivre.com.br e copie o App ID e a Secret Key.
# O servidor gera e renova o token sozinho a partir delas.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# (alternativa: um token fixo, mas ele expira a cada 6 horas)
ML_ACCESS_TOKEN=

# Shopee Open API de afiliados (https://affiliate.shopee.com.br → Open API)
# Necessário para gerar shortlinks comissionados (s.shopee.com.br)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Chave da API da Anthropic — usada para copy personalizada por IA no
# Garimpo de Ofertas e para organizar notas/responder perguntas no
# Segundo Cérebro (/segundo-cerebro). Sem ela, ambos caem em fallbacks
# sem IA.
ANTHROPIC_API_KEY=

# Supabase — obrigatório para o Segundo Cérebro (/segundo-cerebro), que
# guarda as notas na tabela `segundo_cerebro_notes` (ver
# supabase/migrations/0001_segundo_cerebro_notes.sql).
# URL e a service_role key ficam em Project Settings → API no painel do
# Supabase. A service_role key ignora RLS — nunca exponha ela no browser,
# use só nas rotas /api (servidor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
