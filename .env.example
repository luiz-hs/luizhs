# Copie para .env.local e preencha o que tiver. Tudo é opcional —
# a plataforma funciona sem credenciais, com recursos reduzidos.

# Mercado Livre: token OAuth caso a API pública de busca exija autenticação
# (gere em https://developers.mercadolivre.com.br)
ML_ACCESS_TOKEN=

# Shopee Open API de afiliados (https://affiliate.shopee.com.br → Open API)
# Necessário para gerar shortlinks comissionados (s.shopee.com.br)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Chave da API da Anthropic para copy personalizada por IA
# (sem ela, o gerador usa templates locais)
ANTHROPIC_API_KEY=
